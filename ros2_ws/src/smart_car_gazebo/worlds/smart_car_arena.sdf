<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="smart_car_world">

    <!-- ═══════════════════════════════════════════════════ -->
    <!--  PHYSICS CONFIGURATION                              -->
    <!-- ═══════════════════════════════════════════════════ -->
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--  WORLD PLUGINS                                      -->
    <!-- ═══════════════════════════════════════════════════ -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--  LIGHTING                                           -->
    <!-- ═══════════════════════════════════════════════════ -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>0.5 -0.1 -0.8</direction>
    </light>
    <light type="directional" name="ambient_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.1 -0.8</direction>
    </light>


    <!-- ═══════════════════════════════════════════════════ -->
    <!--  GROUND PLANE                                       -->
    <!-- ═══════════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--  ARENA BOUNDARY WALLS (6m x 6m)                     -->
    <!-- ═══════════════════════════════════════════════════ -->
    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>3.0 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 6.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.0 0.5</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.35 1</ambient>
            <diffuse>0.4 0.4 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>-3.0 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 6.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.0 0.5</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.35 1</ambient>
            <diffuse>0.4 0.4 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>0 3.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.0 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.1 0.5</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.35 1</ambient>
            <diffuse>0.4 0.4 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>0 -3.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.0 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.1 0.5</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.35 1</ambient>
            <diffuse>0.4 0.4 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ═══════════════════════════════════════════════════ -->
    <!--  TEST TARGETS & OBSTACLES FOR VISION / NAVIGATION   -->
    <!-- ═══════════════════════════════════════════════════ -->

    <!-- 1. CHAIR TARGET MODEL (Photorealistic 3D target for YOLO chair follow) -->
    <model name="chair_target">
      <static>true</static>
      <pose>2.5 0.0 0.45 0 0 3.14159</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.10 0.65 0.90</size></box></geometry>
        </collision>
        <visual name="chair_visual">
          <geometry><box><size>0.02 0.65 0.90</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>/home/diya/smart_car/ros2_ws/src/smart_car_gazebo/materials/textures/chair_texture.png</albedo_map>
                <roughness>0.9</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- 2. PERSON TARGET MODEL (Photorealistic 3D target for YOLO person follow) -->
    <model name="person_target">
      <static>true</static>
      <pose>2.4 1.3 0.80 0 0 3.14159</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.10 0.60 1.60</size></box></geometry>
        </collision>
        <visual name="person_visual">
          <geometry><box><size>0.02 0.60 1.60</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>/home/diya/smart_car/ros2_ws/src/smart_car_gazebo/materials/textures/person_texture.png</albedo_map>
                <roughness>0.9</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- 3. BOTTLE TARGET MODEL (Photorealistic 3D target for YOLO bottle follow) -->
    <model name="bottle_target">
      <static>true</static>
      <pose>2.0 -1.1 0.35 0 0 3.14159</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.10 0.35 0.70</size></box></geometry>
        </collision>
        <visual name="bottle_visual">
          <geometry><box><size>0.02 0.35 0.70</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>/home/diya/smart_car/ros2_ws/src/smart_car_gazebo/materials/textures/bottle_texture.png</albedo_map>
                <roughness>0.9</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>



    <!-- 4. RED TARGET CYLINDER (for Color Follow Demonstrations) -->
    <model name="red_target_cylinder">
      <static>true</static>
      <pose>2.4 -1.8 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.12</radius><length>0.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>0.4</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>1.0 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 5. YELLOW OBSTACLE CYLINDER (Primary obstacle blocking forward path) -->
    <model name="yellow_obstacle_cylinder">
      <static>true</static>
      <pose>1.2 0.18 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.10</radius><length>0.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.10</radius><length>0.4</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.8 0.1 1</ambient>
            <diffuse>1.0 0.9 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- 6. BLUE OBSTACLE BOX (Lateral obstacle on the left) -->
    <model name="blue_obstacle_box">
      <static>true</static>
      <pose>1.1 0.7 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.4</size></box></geometry>
          <material>
            <ambient>0.1 0.2 0.8 1</ambient>
            <diffuse>0.1 0.3 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 7. ARUCO MARKER BOARD (ID 7 target for ArUco 6-DOF Pose Navigation Demo) -->
    <model name="aruco_marker_board">
      <static>true</static>
      <pose>2.0 -0.6 0.25 0 0 3.14159</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 0.35 0.35</size></box></geometry>
        </collision>
        <visual name="board_visual">
          <geometry><box><size>0.05 0.35 0.35</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>../materials/textures/aruco_marker_7.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- 8. LANE LINES (LEFT & RIGHT) (Boundary markings for Road Lane-Following Demo) -->
    <model name="lane_left">
      <static>true</static>
      <pose>1.5 0.35 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.6 0.04 0.001</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.2 0.2 0.2 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <model name="lane_right">
      <static>true</static>
      <pose>1.5 -0.35 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.6 0.04 0.001</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.2 0.2 0.2 1</emissive>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
