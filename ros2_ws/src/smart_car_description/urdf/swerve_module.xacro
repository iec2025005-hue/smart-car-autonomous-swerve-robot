<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="swerve_module" params="prefix parent x_offset y_offset z_offset steer_mesh wheel_mesh">

    <!-- 1. STEERING JOINT (Vertical rotation around Z axis) -->
    <joint name="${prefix}_steer_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${prefix}_steer_link"/>
      <origin xyz="${x_offset} ${y_offset} ${z_offset}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.01" friction="0.005"/>
      <limit effort="500.0" velocity="50.0"/>
    </joint>

    <!-- 2. STEERING LINK (Real CAD Pod bracket) -->
    <link name="${prefix}_steer_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://smart_car_description/meshes/${steer_mesh}" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="steer_bracket_mat">
          <color rgba="0.2 0.2 0.25 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.035" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.025" length="0.05"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.035" rpy="0 0 0"/>
        <mass value="0.25"/>
        <inertia
          ixx="0.00015" ixy="0.0" ixz="0.0"
          iyy="0.00015" iyz="0.0"
          izz="0.00012"/>
      </inertial>
    </link>

    <!-- 3. WHEEL JOINT (Axle rotation around Y axis) -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_steer_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.01" friction="0.005"/>
      <limit effort="100.0" velocity="50.0"/>
    </joint>

    <!-- 4. WHEEL LINK (Real CAD Wheel Rim + Tire) -->
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://smart_car_description/meshes/${wheel_mesh}" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="rubber_black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.039965" length="0.03765"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.15"/>
        <inertia
          ixx="0.000078" ixy="0.0" ixz="0.0"
          iyy="0.000120" iyz="0.0"
          izz="0.000078"/>
      </inertial>
    </link>

    <!-- 5. GAZEBO SURFACE / FRICTION PROPERTIES -->
    <gazebo reference="${prefix}_steer_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/Black</material>
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>

  </xacro:macro>

</robot>
