<?xml version="1.0"?>
<robot name="smart_car" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ═══════════════════════════════════════════════════ -->
  <!--  PROPERTIES & CONSTANTS                             -->
  <!-- ═══════════════════════════════════════════════════ -->
  <!-- ═══════════════════════════════════════════════════ -->
  <!--  PROPERTIES & CONSTANTS (from Fusion 360 CAD)       -->
  <!-- ═══════════════════════════════════════════════════ -->
  <xacro:property name="wheelbase" value="0.208"/>      <!-- L = 20.8 cm -->
  <xacro:property name="track_width" value="0.2285"/>   <!-- W = 22.85 cm -->
  <xacro:property name="chassis_length" value="0.284"/> <!-- 28.4 cm -->
  <xacro:property name="chassis_width" value="0.282"/>  <!-- 28.2 cm -->
  <xacro:property name="chassis_height" value="0.13"/>  <!-- 13.0 cm -->
  <xacro:property name="chassis_mass" value="2.5"/>     <!-- 2.5 kg -->
  <xacro:property name="wheel_radius" value="0.039965"/> <!-- 39.965 mm outer radius (79.93 mm diameter) -->
  <xacro:property name="wheel_width" value="0.03765"/>   <!-- 37.65 mm width/thickness -->
  <xacro:property name="wheel_hub_hole" value="0.00484"/> <!-- 4.84 mm axle hole diameter -->

  <!-- Include Swerve Module and Sensor Macros (relative includes work in all environments) -->
  <xacro:include filename="swerve_module.xacro"/>
  <xacro:include filename="sensors.xacro"/>

  <!-- ═══════════════════════════════════════════════════ -->
  <!--  BASE FOOTPRINT (Ground projection Z = 0)           -->
  <!-- ═══════════════════════════════════════════════════ -->
  <link name="base_footprint"/>

  <!-- ═══════════════════════════════════════════════════ -->
  <!--  BASE LINK (Vehicle Center at Wheel Center Height) -->
  <!-- ═══════════════════════════════════════════════════ -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- Visual representation of the real Fusion 360 Chassis -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://smart_car_description/meshes/chassis.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>

    <!-- Collision geometry (Chassis deck positioned with clearance above swerve pods) -->
    <collision>
      <origin xyz="0 0 0.095" rpy="0 0 0"/>
      <geometry>
        <box size="0.250 0.160 0.040"/>
      </geometry>
    </collision>

    <!-- Inertial properties of the 2.5 kg chassis -->
    <inertial>
      <origin xyz="0 0 0.095" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="0.0198" ixy="0.0" ixz="0.0"
        iyy="0.0201" iyz="0.0"
        izz="0.0334"/>
    </inertial>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════ -->
  <!--  FOUR INDEPENDENT SWERVE MODULES (Exact CAD Meshes) -->
  <!-- ═══════════════════════════════════════════════════ -->

  <!-- Front-Left (FL): x = +0.104, y = +0.11425 -->
  <xacro:swerve_module
    prefix="fl"
    parent="base_link"
    x_offset="${wheelbase / 2.0}"
    y_offset="${track_width / 2.0}"
    z_offset="0.0"
    steer_mesh="fl_steer_bracket.dae"
    wheel_mesh="wheel_left.dae"/>

  <!-- Front-Right (FR): x = +0.104, y = -0.11425 -->
  <xacro:swerve_module
    prefix="fr"
    parent="base_link"
    x_offset="${wheelbase / 2.0}"
    y_offset="${-track_width / 2.0}"
    z_offset="0.0"
    steer_mesh="fr_steer_bracket.dae"
    wheel_mesh="wheel_right.dae"/>

  <!-- Rear-Left (RL): x = -0.104, y = +0.11425 -->
  <xacro:swerve_module
    prefix="rl"
    parent="base_link"
    x_offset="${-wheelbase / 2.0}"
    y_offset="${track_width / 2.0}"
    z_offset="0.0"
    steer_mesh="rl_steer_bracket.dae"
    wheel_mesh="wheel_left.dae"/>

  <!-- Rear-Right (RR): x = -0.104, y = -0.11425 -->
  <xacro:swerve_module
    prefix="rr"
    parent="base_link"
    x_offset="${-wheelbase / 2.0}"
    y_offset="${-track_width / 2.0}"
    z_offset="0.0"
    steer_mesh="rr_steer_bracket.dae"
    wheel_mesh="wheel_right.dae"/>

  <!-- ═══════════════════════════════════════════════════ -->
  <!--  GAZEBO SIMULATION PLUGINS                          -->
  <!-- ═══════════════════════════════════════════════════ -->

  <!-- Joint State Publisher Plugin -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <update_rate>50</update_rate>
      <joint_name>fl_steer_joint</joint_name>
      <joint_name>fr_steer_joint</joint_name>
      <joint_name>rl_steer_joint</joint_name>
      <joint_name>rr_steer_joint</joint_name>
      <joint_name>fl_wheel_joint</joint_name>
      <joint_name>fr_wheel_joint</joint_name>
      <joint_name>rl_wheel_joint</joint_name>
      <joint_name>rr_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- 4× Position Controllers for Steering Joints (Stable Critical Damping) -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>fl_steer_joint</joint_name>
      <topic>fl_steer_cmd</topic>
      <p_gain>16.0</p_gain>
      <i_gain>1.0</i_gain>
      <d_gain>0.3</d_gain>
      <i_max>2.0</i_max>
      <i_min>-2.0</i_min>
      <cmd_max>15.0</cmd_max>
      <cmd_min>-15.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>fr_steer_joint</joint_name>
      <topic>fr_steer_cmd</topic>
      <p_gain>16.0</p_gain>
      <i_gain>1.0</i_gain>
      <d_gain>0.3</d_gain>
      <i_max>2.0</i_max>
      <i_min>-2.0</i_min>
      <cmd_max>15.0</cmd_max>
      <cmd_min>-15.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>rl_steer_joint</joint_name>
      <topic>rl_steer_cmd</topic>
      <p_gain>16.0</p_gain>
      <i_gain>1.0</i_gain>
      <d_gain>0.3</d_gain>
      <i_max>2.0</i_max>
      <i_min>-2.0</i_min>
      <cmd_max>15.0</cmd_max>
      <cmd_min>-15.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>rr_steer_joint</joint_name>
      <topic>rr_steer_cmd</topic>
      <p_gain>16.0</p_gain>
      <i_gain>1.0</i_gain>
      <d_gain>0.3</d_gain>
      <i_max>2.0</i_max>
      <i_min>-2.0</i_min>
      <cmd_max>15.0</cmd_max>
      <cmd_min>-15.0</cmd_min>
    </plugin>
  </gazebo>

  <!-- 4× Velocity Controllers for Drive Wheel Joints -->
  <gazebo>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>fl_wheel_joint</joint_name>
      <topic>fl_wheel_cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>15.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.05</d_gain>
      <cmd_max>10.0</cmd_max>
      <cmd_min>-10.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>fr_wheel_joint</joint_name>
      <topic>fr_wheel_cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>15.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.05</d_gain>
      <cmd_max>10.0</cmd_max>
      <cmd_min>-10.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rl_wheel_joint</joint_name>
      <topic>rl_wheel_cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>15.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.05</d_gain>
      <cmd_max>10.0</cmd_max>
      <cmd_min>-10.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rr_wheel_joint</joint_name>
      <topic>rr_wheel_cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>15.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.05</d_gain>
      <cmd_max>10.0</cmd_max>
      <cmd_min>-10.0</cmd_min>
    </plugin>
  </gazebo>

</robot>
